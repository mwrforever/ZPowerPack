{
  "name": "zpowerpack",
  "version": "0.3.1",
  "description": "ZPowerPack：zcode 存储迁移向导与当前会话实时 token 速率常驻条。",
  "author": { "name": "ZPowerPack" },
  "license": "MIT",
  "skills": "skills",
  "extension": {
    "engines": { "zcode": "^1.4.0" },
    "main": "extension/main.js",
    "activationEvents": ["onAvailable"],
    "contributes": {
      "commands": [
        { "id": "zpowerpack-rate-status", "title": "ZPowerPack 实时速率状态" }
      ]
    }
  },
  "slots": {
    "composer.status": [
      { "id": "zpowerpack-mini", "order": 1, "icon": "gauge", "title": "ZPowerPack 实时速率", "target": { "command": "zpowerpack-rate-status" } }
    ]
  }
}
